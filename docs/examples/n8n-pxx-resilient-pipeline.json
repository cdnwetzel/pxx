    "jsCode": "const hits=($input.first().json.results||[]).map(r=>r.content);\nconst conv=hits[0]||'(no prior memory)';\nconst task='Add a multiply(a, b) function to mathlib.py returning a*b; keep add; edit only mathlib.py. Convention from memory: '+conv;\nreturn [{json:{task, conv, attempt:1}}];"
   },
