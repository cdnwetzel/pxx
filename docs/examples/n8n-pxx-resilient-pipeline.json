   ]
  },
  {
   "parameters": {
    "jsCode": "const raw=String($input.first().json.data||$input.first().json.body||'');let terminal='UNKNOWN';for(const line of raw.split('\\n')){const s=line.trim();if(!s.startsWith('data:'))continue;let e;try{e=JSON.parse(s.slice(5).trim());}catch(_){continue;}if((e.kind||'')==='session_end')terminal=(e.data&&e.data.code)||terminal;}return [{json:{attempt:1,terminal}}];"
   },
